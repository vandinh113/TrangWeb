
@model DBSportStore.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="container" style="padding-top:30px; padding-bottom:40px;">

    <h2>CHỈNH SỬA DANH MỤC</h2>

    <p>Cập nhật thông tin danh mục sản phẩm trong hệ thống SportStore.</p>

    <hr />

    <div class="row">
        <div class="col-md-7">

            <div class="panel panel-default">

                <div class="panel-heading">
                    <strong>Thông tin danh mục</strong>
                </div>

                <div class="panel-body">

                    @using (Html.BeginForm("Edit", "Categories",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(model => model.CategoryID)

                        @Html.ValidationSummary(
                            true, "", new { @class = "text-danger" })

                        <div class="form-group">

                            <label>Mã danh mục</label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.CategoryID"
                                   readonly="readonly" />

                        </div>

                        <div class="form-group">

                            @Html.LabelFor(
                                model => model.CategoryName,
                                "Tên danh mục"
                            )

                            @Html.TextBoxFor(
                                model => model.CategoryName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập tên danh mục",
                                    maxlength = "100"
                                }
                            )

                            @Html.ValidationMessageFor(
                                model => model.CategoryName,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <div class="form-group" style="margin-top:20px;">

                            <button type="submit"
                                    class="btn btn-primary">
                                Lưu thay đổi
                            </button>

                            @Html.ActionLink(
                                "Quay lại",
                                "Index",
                                "Categories",
                                null,
                                new { @class = "btn btn-default" }
                            )

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
