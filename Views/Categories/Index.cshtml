
@model IEnumerable<DBSportStore.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<div class="container" style="padding-top: 30px; padding-bottom: 40px;">

    <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-8">
            <h2>QUẢN LÝ DANH MỤC</h2>
            <p>Danh sách các danh mục sản phẩm trong hệ thống SportStore.</p>
        </div>

        <div class="col-md-4 text-right" style="padding-top: 20px;">
            @Html.ActionLink(
                "+ Thêm danh mục",
                "Create",
                "Categories",
                null,
                new { @class = "btn btn-success" }
            )
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Danh sách danh mục</strong>
        </div>

        <div class="panel-body">

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Mã danh mục</th>
                            <th>Tên danh mục</th>
                            <th style="width: 250px;">Chức năng</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CategoryID</td>
                                    <td>@item.CategoryName</td>
                                    <td>
                                        @Html.ActionLink(
                                            "Sửa",
                                            "Edit",
                                            new { id = item.CategoryID },
                                            new { @class = "btn btn-warning btn-sm" }
                                        )

                                        @Html.ActionLink(
                                            "Chi tiết",
                                            "Details",
                                            new { id = item.CategoryID },
                                            new { @class = "btn btn-info btn-sm" }
                                        )

                                        @Html.ActionLink(
                                            "Xóa",
                                            "Delete",
                                            new { id = item.CategoryID },
                                            new { @class = "btn btn-danger btn-sm" }
                                        )
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center">
                                    Chưa có danh mục nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div style="margin-top: 20px;">
        @Html.ActionLink(
            "← Về trang chủ",
            "Index",
            "Store",
            null,
            new { @class = "btn btn-default" }
        )
    </div>

</div>
