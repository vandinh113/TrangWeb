@* LAYOUT DUNG CHUNG CHO WEBSITE SPORTSTORE *@

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - SportStore</title>

    @Styles.Render("~/Content/css")

    <link href="@Url.Content("~/Content/sportstore.css")"
          rel="stylesheet" />

    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <!-- THANH THONG BAO -->
    <div class="store-topbar">
        <div class="container">
            Miễn phí giao hàng cho đơn từ 1.000.000đ
        </div>
    </div>

    <!-- HEADER -->
    <header class="store-header">
        <div class="container">

            <!-- LOGO -->
            <a class="brand"
               href="@Url.Action("Index", "Store")">
                SPORT<span>STORE</span>
            </a>

            <!-- MENU CHINH -->
            <nav class="store-nav">

                @Html.ActionLink(
                    "Trang chủ",
                    "Index",
                    "Store"
                )

                @Html.ActionLink(
                    "Giới thiệu",
                    "AboutStore",
                    "Store"
                )

                @Html.ActionLink(
                    "Quản lý sản phẩm",
                    "Index",
                    "Products"
                )

                @Html.ActionLink(
                    "Quản lý danh mục",
                    "Index",
                    "Categories"
                )

                <a href="#">Giỏ hàng</a>

                <a href="#">Đăng nhập</a>

            </nav>

        </div>
    </header>

    <!-- NOI DUNG TRANG -->
    <main class="container">

        @RenderBody()

    </main>

    <!-- FOOTER -->
    <footer class="store-footer">
        <div class="container">

            <strong>SPORTSTORE</strong>

            <p>
                Website thương mại thực hành ASP.NET MVC5
            </p>

            <p>
                Hệ thống quản lý sản phẩm và danh mục
            </p>

        </div>
    </footer>

    <!-- JAVASCRIPT -->
    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
